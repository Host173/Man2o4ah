# backend/.env
MONGODB_URI=<team-mongodb-atlas-connection-string>
PORT=4000
FRONTEND_URL=http://localhost:3000
PLATFORM_CURRENCY=USD
UPLOAD_DIR=uploads
# Any long random string; generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<long-random-string>
# Exchange rates (ITN-18). Optional: FXRatesAPI works without a key at low volume.
FXRATES_API_KEY=
# false = no fetch at start-up or by the daily job (offline development)
FX_AUTO_REFRESH=true
# Stripe, test mode only (PAY-01). Dashboard → Developers → API keys (sandbox).
STRIPE_SECRET_KEY=sk_test_...
# Printed by: stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Admin account created by `npm run seed:admin` (ACC-18). Password: 8-72 chars, a letter and a digit.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<choose-a-strong-password>
# Shared password of the demo accounts created by `npm run seed:demo` (PLT-08). Same rule as above.
DEMO_PASSWORD=

# Email (GEN-01-B). Disabled unless explicitly enabled; use a test SMTP sink in development.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required outside production when enabled. Both headers and envelope go only here.
SMTP_TEST_INBOX=

# frontend/.env.local
BACKEND_URL=http://localhost:4000
# Publishable key, used by the payment page in M2
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
