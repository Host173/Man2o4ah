{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "postinstall": "playwright install chromium",
    "deploy": "nest deploy",
    "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev:stripe": "node scripts/dev-stripe.mjs",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:stress": "vitest run --config ./vitest.config.stress.ts",
    "test:audit": "vitest run --config ./vitest.config.audit.ts",
    "openapi:export": "vitest run --config ./vitest.config.openapi.ts",
    "seed:reference": "nest build && node dist/seed/seed-reference-data.js",
    "seed:admin": "nest build && node dist/seed/seed-admin.js",
    "seed:demo": "nest build && node dist/seed/seed-demo-data.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:cov && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "fontkit": "^3.0.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.12.1",
    "playwright": "^1.65.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
