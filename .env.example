# backend/.env
MONGODB_URI=<team-mongodb-atlas-connection-string>
PORT=4000
FRONTEND_URL=http://localhost:3000
PLATFORM_CURRENCY=USD
UPLOAD_DIR=uploads
# Any long random string; generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<long-random-string>
# Exchange rates (ITN-18). Optional: FXRatesAPI works without a key at low volume.
FXRATES_API_KEY=
# false = no fetch at start-up or by the daily job (offline development)
FX_AUTO_REFRESH=true

# frontend/.env.local
BACKEND_URL=http://localhost:4000
